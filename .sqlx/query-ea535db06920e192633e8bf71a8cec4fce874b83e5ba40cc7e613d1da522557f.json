  "query": "\n        SELECT id, name, type AS \"kind: ItemKind\", unit AS \"unit: ItemUnit\", owner_id IS NOT NULL AS \"is_custom!\"\n        FROM items\n        WHERE id = $1 AND (owner_id IS NULL OR owner_id = $2)\n        ",
