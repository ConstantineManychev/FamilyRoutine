  "query": "\n        SELECT e.id, e.type AS \"ex_type: ExType\",\n               COALESCE((SELECT g.pct FROM ex_musc_grps g WHERE g.ex_id = e.id AND g.grp = 'legs'), 0) >= $2 AS \"is_lower_body!\"\n        FROM dict_exs e WHERE e.id = ANY($1)\n        ",
