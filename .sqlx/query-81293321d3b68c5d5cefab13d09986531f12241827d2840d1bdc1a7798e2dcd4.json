{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, status AS \"status: RoutineStatus\", note, start_ts, end_ts\n        FROM status_marks\n        WHERE user_id = $1 AND NOT is_planned AND start_ts <= NOW() AND (end_ts IS NULL OR end_ts > NOW())\n        ORDER BY start_ts DESC\n        LIMIT 1\n        ",
