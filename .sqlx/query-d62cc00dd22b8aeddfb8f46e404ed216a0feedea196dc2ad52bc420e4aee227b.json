{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            a.id,\n            a.curr_id,\n            a.account_type AS \"account_type: AccountType\",\n            a.conn_id,\n            BOOL_OR(v.is_editor) AS \"is_editor!\"\n        FROM accounts a\n        JOIN account_viewers v ON v.account_id = a.id\n        WHERE a.id = $1 AND v.viewer_id = $2\n        GROUP BY a.id\n        ",
