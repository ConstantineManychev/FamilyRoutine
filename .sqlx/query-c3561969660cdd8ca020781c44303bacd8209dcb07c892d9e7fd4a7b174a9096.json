{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, status AS \"status: RoutineStatus\", note, start_ts, end_ts\n        FROM status_marks\n        WHERE user_id = $1 AND status = 'meal' AND NOT is_planned\n          AND ((start_ts >= $2 AND start_ts < $3) OR id = ANY($4))\n        ORDER BY start_ts\n        ",
