{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            i.id,\n            i.name,\n            i.unit AS \"unit: ItemUnit\",\n            GREATEST(similarity(LOWER(i.name), $2), similarity(LOWER(i.name), $3))::float8 AS \"score!\"\n        FROM items i\n        WHERE LOWER(i.name) % $2 OR LOWER(i.name) % $3\n        ORDER BY 4 DESC, (i.owner_id IS NOT DISTINCT FROM $1) DESC\n        LIMIT 1\n        ",
