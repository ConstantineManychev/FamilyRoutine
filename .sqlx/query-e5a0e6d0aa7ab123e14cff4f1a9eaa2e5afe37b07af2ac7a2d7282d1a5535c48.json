  "query": "\n        SELECT fm.role AS \"role: MemberRole\", (f.owner_id = fm.user_id) AS \"is_owner!\"\n        FROM family_mems fm\n        JOIN families f ON f.id = fm.family_id\n        WHERE fm.family_id = $1 AND fm.user_id = $2\n        ",
