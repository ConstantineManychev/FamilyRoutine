  "query": "\n        SELECT i.occ_date, i.moved_date, i.moved_time, m.id AS mark_id, m.status AS \"status: RoutineStatus\"\n        FROM plan_instances i\n        JOIN status_marks m ON m.id = i.status_mark_id AND m.is_planned\n        WHERE i.event_id = $1\n        ",
