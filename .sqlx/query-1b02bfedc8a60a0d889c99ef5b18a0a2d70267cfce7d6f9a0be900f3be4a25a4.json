  "query": "\n        SELECT mp.place_id, mp.merchant_id, m.name, mp.place_addr_id\n        FROM merchant_places mp\n        JOIN merchants m ON m.id = mp.merchant_id\n        WHERE mp.user_id = $1 AND mp.place_id = ANY($2)\n        ORDER BY m.name\n        ",
