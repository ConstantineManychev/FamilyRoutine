{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT f.id AS family_id, f.name AS family_name, fm.is_body_shared, fm.is_composition_shared,\n                   fm.is_measures_shared, fm.is_training_shared\n            FROM family_mems fm\n            JOIN families f ON f.id = fm.family_id\n            WHERE fm.user_id = $1\n            ORDER BY f.name\n            ",
