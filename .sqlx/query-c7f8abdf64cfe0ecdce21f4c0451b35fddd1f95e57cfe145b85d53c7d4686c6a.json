  "query": "\n        SELECT\n            owner_id,\n            family_id,\n            unit AS \"unit: ItemUnit\",\n            ((owner_id IS NULL AND family_id IS NULL) OR can_see_scoped(owner_id, family_id, $2)) AS \"is_visible!\",\n            can_edit_scoped(owner_id, family_id, created_by, $2) AS \"is_editable!\"\n        FROM items\n        WHERE id = $1\n        FOR UPDATE\n        ",
