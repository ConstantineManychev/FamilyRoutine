  "query": "\n            SELECT i.id, i.name, i.unit AS \"unit: ItemUnit\"\n            FROM item_aliases a\n            JOIN items i ON i.id = a.item_id\n            WHERE a.user_id = $1 AND a.alias_key = $2\n            ",
