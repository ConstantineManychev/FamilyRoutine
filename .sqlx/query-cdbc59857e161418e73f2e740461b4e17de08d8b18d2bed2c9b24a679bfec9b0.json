{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT status AS \"status: RoutineStatus\", note, end_ts\n        FROM status_marks\n        WHERE user_id = $1 AND NOT is_planned AND start_ts < $2 AND (end_ts IS NULL OR end_ts > $2)\n        ORDER BY start_ts DESC\n        LIMIT 1\n        ",
