  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.name,\n            p.family_id,\n            f.name AS \"family_name?\",\n            can_edit_scoped(p.owner_id, p.family_id, p.created_by, $2) AS \"is_editable!\"\n        FROM places p\n        LEFT JOIN families f ON f.id = p.family_id\n        WHERE p.id = $1 AND can_see_scoped(p.owner_id, p.family_id, $2)\n        ",
