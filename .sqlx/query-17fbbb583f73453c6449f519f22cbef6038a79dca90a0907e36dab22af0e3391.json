{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.event_id, s.topic_id, t.title AS topic_title, s.note\n        FROM plan_studies s\n        JOIN study_topics t ON t.id = s.topic_id\n        WHERE s.event_id = ANY($1) AND s.occ_date IS NOT DISTINCT FROM $2\n        ORDER BY s.event_id, s.position\n        ",
