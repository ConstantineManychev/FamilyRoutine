{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            di.dish_id,\n            di.item_id,\n            i.name AS item_name,\n            i.unit AS \"unit: ItemUnit\",\n            i.piece_g,\n            di.grams,\n            i.kcal,\n            i.prot,\n            i.fat,\n            i.carb\n        FROM dish_ingredients di\n        JOIN items i ON i.id = di.item_id\n        WHERE di.dish_id = ANY($1)\n        ORDER BY di.dish_id, di.position\n        ",
