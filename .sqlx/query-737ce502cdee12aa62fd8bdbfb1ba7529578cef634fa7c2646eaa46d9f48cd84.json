{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.task_id, t.title AS task_title, e.kind AS \"kind: TaskEventKind\", e.report, e.event_ts\n        FROM work_task_events e\n        JOIN work_tasks t ON t.id = e.task_id\n        WHERE t.user_id = $1 AND e.status_mark_id = $2\n        ORDER BY e.seq\n        ",
