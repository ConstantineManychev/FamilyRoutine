  "query": "\n        SELECT user_id, started_ts, finished_ts AS \"finished_ts!\", kcal::float8 AS \"kcal!\"\n        FROM workout_sessions\n        WHERE user_id = ANY($1) AND finished_ts IS NOT NULL AND kcal IS NOT NULL\n          AND started_ts < $3 AND finished_ts > $2\n        ",
