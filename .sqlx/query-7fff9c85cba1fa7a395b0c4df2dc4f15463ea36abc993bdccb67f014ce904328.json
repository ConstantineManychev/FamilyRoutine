{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.id, e.user_id, e.grams AS \"grams!\"\n        FROM meal_entries e\n        WHERE e.item_id = $1 AND e.batch_id IS NULL AND e.stock_short > 0 AND e.grams IS NOT NULL\n          AND e.created_ts >= $2\n        ORDER BY e.created_ts, e.id\n        ",
