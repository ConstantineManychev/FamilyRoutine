{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            t.account_id,\n            t.amount,\n            t.source AS \"source: TxSource\",\n            t.transfer_id,\n            t.receipt_id,\n            v.is_editor AS \"is_editor!\"\n        FROM transactions t\n        JOIN account_viewers v ON v.account_id = t.account_id AND v.viewer_id = $2\n        WHERE t.id = $1\n        ",
