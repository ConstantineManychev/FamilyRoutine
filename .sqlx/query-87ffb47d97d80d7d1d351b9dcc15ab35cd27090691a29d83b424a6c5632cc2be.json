{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            f.id,\n            f.name,\n            fm.role AS \"role: MemberRole\",\n            (f.owner_id = fm.user_id) AS \"is_owner!\",\n            (SELECT COUNT(*) FROM family_mems m WHERE m.family_id = f.id) AS \"member_count!\"\n        FROM families f\n        JOIN family_mems fm ON fm.family_id = f.id\n        WHERE fm.user_id = $1\n        ORDER BY f.name\n        ",
