{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT entry_id, measured_ts, value\n        FROM (\n            SELECT e.id AS entry_id, e.measured_ts, v.value\n            FROM body_values v\n            JOIN body_entries e ON e.id = v.entry_id\n            WHERE e.user_id = $1 AND v.metric = $2\n            ORDER BY e.measured_ts DESC\n            LIMIT $3\n        ) recent\n        ORDER BY measured_ts\n        ",
  "describe": {
