{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.provider AS \"provider: BankProvider\",\n            c.aspsp_name,\n            c.status AS \"status: BankConnStatus\",\n            c.valid_until,\n            c.last_sync_ts,\n            c.next_sync_ts,\n            c.last_error,\n            (SELECT COUNT(*) FROM accounts a WHERE a.conn_id = c.id) AS \"account_count!\"\n        FROM bank_conns c\n        WHERE c.owner_id = $1 AND c.status <> 'pending'\n        ORDER BY c.created_ts\n        ",
