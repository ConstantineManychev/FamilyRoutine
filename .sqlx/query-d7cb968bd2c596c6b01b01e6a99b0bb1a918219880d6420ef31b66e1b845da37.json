{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            t.id,\n            t.balance_doc_id AS \"balance_doc_id!\",\n            t.tx_ts,\n            t.amount,\n            t.category AS \"category: TxCategory\",\n            t.note\n        FROM transactions t\n        JOIN balance_docs d ON d.id = t.balance_doc_id\n        WHERE d.account_id = $1\n        ORDER BY t.tx_ts, t.id\n        ",
