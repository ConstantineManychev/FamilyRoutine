{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.parent_id, t.title, t.description, t.unit AS \"unit: StudyUnit\", t.target, t.done, t.updated_ts,\n               (SELECT COUNT(*) FROM study_notes n WHERE n.topic_id = t.id) AS \"note_count!\"\n        FROM study_topics t\n        WHERE t.user_id = $1\n        ORDER BY t.created_ts, t.id\n        ",
