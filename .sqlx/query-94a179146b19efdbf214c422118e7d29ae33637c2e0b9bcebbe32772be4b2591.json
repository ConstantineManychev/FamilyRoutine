  "query": "\n        SELECT m.id, m.user_id, m.status AS \"status: RoutineStatus\", m.note, m.start_ts, m.end_ts, m.is_planned,\n               u.first_name, u.last_name\n        FROM status_marks m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.id = $1\n        ",
