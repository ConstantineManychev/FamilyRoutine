  "db_name": "PostgreSQL",
  "query": "\n        SELECT ri.item_id, i.name, i.type AS \"kind: ItemKind\", i.unit AS \"unit: ItemUnit\", ri.qty, ri.unit_price, ri.amount\n        FROM receipt_items ri\n        JOIN items i ON i.id = ri.item_id\n        WHERE ri.receipt_id = $1\n        ORDER BY ri.pos\n        ",
