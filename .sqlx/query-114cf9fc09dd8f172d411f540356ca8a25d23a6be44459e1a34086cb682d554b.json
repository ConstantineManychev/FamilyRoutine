{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, start_ts, end_ts\n        FROM status_marks\n        WHERE user_id = $1 AND id <> $2 AND NOT is_planned AND start_ts >= $3\n          AND ($4::timestamptz IS NULL OR start_ts < $4)\n        ORDER BY start_ts\n        ",
