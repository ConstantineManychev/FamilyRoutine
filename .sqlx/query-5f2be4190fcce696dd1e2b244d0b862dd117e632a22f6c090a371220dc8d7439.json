  "query": "\n        SELECT id, topic_id, body, note_ts, created_ts, updated_ts\n        FROM study_notes\n        WHERE user_id = $1 AND note_ts >= $2 AND note_ts <= COALESCE($3, NOW())\n        ORDER BY note_ts\n        LIMIT $4\n        ",
