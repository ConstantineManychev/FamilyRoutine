  "query": "\n        INSERT INTO streets (city_id, name, created_by)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (city_id, name) DO UPDATE SET name = EXCLUDED.name\n        RETURNING id, city_id, name, COALESCE(created_by = $3, FALSE) AS \"is_editable!\"\n        ",
