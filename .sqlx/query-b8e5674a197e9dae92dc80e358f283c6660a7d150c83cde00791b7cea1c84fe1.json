  "query": "\n        SELECT id, measured_ts, source AS \"source: BodySource\", note\n        FROM body_entries\n        WHERE user_id = $1 AND ($2::TIMESTAMPTZ IS NULL OR measured_ts < $2)\n        ORDER BY measured_ts DESC\n        LIMIT $3\n        ",
