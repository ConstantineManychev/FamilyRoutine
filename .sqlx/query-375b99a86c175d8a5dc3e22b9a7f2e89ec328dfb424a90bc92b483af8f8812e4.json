{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT i.id, i.name, i.unit AS \"unit: ItemUnit\"\n            FROM items i\n            WHERE i.barcode = $2\n              AND (i.owner_id = $1 OR (i.owner_id IS NULL AND i.family_id IS NULL)\n                   OR i.family_id IN (SELECT family_id FROM family_mems WHERE user_id = $1))\n            ORDER BY (i.owner_id = $1) DESC\n            LIMIT 1\n            ",
