  "query": "\n        SELECT id, user_id, status AS \"status: RoutineStatus\", note, start_ts, end_ts\n        FROM status_marks\n        WHERE user_id = ANY($1) AND start_ts < $3 AND (end_ts IS NULL OR end_ts > $2)\n        ORDER BY user_id, start_ts\n        ",
