  "query": "\n        INSERT INTO cities (country_id, name, created_by)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (country_id, name) DO UPDATE SET name = EXCLUDED.name\n        RETURNING id, country_id, name, COALESCE(created_by = $3, FALSE) AS \"is_editable!\"\n        ",
