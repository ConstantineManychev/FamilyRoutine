  "query": "\n        SELECT r.ord AS \"ord!\", uah_rate(c.id, r.day) AS src_rate, uah_rate($3, r.day) AS dst_rate\n        FROM UNNEST($1::text[], $2::date[]) WITH ORDINALITY AS r(code, day, ord)\n        JOIN currencies c ON c.code = r.code\n        ",
