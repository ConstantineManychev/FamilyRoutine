  "query": "\n        SELECT me.user_id, COALESCE(m.start_ts, me.created_ts) AS \"ts!\", me.kcal::float8 AS \"kcal!\"\n        FROM meal_entries me\n        LEFT JOIN status_marks m ON m.id = me.status_mark_id\n        WHERE me.user_id = ANY($1) AND me.eaten_on = $2\n        ",
