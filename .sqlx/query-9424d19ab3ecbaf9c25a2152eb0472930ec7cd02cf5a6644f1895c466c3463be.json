{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT t.id, t.amount, t.mcc, t.description, t.counterparty, t.is_category_locked,\n                   COALESCE(a.user_id, t.user_id) AS \"owner_id!\"\n            FROM transactions t\n            JOIN accounts a ON a.id = t.account_id\n            WHERE t.source = 'bank' AND t.rule_key IS NULL\n            ORDER BY t.id\n            LIMIT $1\n            ",
